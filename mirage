#!/usr/bin/env bash
# MIRAGE launcher: ./mirage help
# Finds the repository root (even when called from another directory or via a symlink), picks any
# Python 3 for the standard-library launcher, and hands over to scripts/mirage_cli.py. Project
# dependencies live in .venv; this script never installs anything itself.
set -euo pipefail

SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
ROOT="$(cd -P "$(dirname "$SOURCE")" && pwd)"

case "$(uname -s)" in
  Linux|Darwin) ;;
  *)
    echo "MIRAGE supports Ubuntu 24.04, WSL2 Ubuntu and Linux (macOS secondary)." >&2
    echo "On Windows, install WSL2 (wsl --install -d Ubuntu-24.04) and run ./mirage inside the Ubuntu terminal." >&2
    exit 1
    ;;
esac

PY=""
for cand in python3 python; do
  if command -v "$cand" >/dev/null 2>&1 && "$cand" -c 'import sys; sys.exit(0 if sys.version_info >= (3, 9) else 1)' 2>/dev/null; then
    PY="$cand"
    break
  fi
done
if [ -z "$PY" ]; then
  echo "MIRAGE needs a Python 3 interpreter to start the launcher." >&2
  echo "  Ubuntu/WSL:  sudo apt update && sudo apt install -y python3 python3-venv git" >&2
  echo "  macOS:       brew install python" >&2
  exit 1
fi

cd "$ROOT"
exec "$PY" "$ROOT/scripts/mirage_cli.py" "$@"
