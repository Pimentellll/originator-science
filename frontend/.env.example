# LIVE is the default transport. Use ?transport=mock (or the line below) for DEV / MOCK data.
# VITE_MIRAGE_TRANSPORT=mock

# Where the MIRAGE API is reachable from the *dev server* (not the browser). Default http://localhost:8000
# MIRAGE_API_PROXY=http://localhost:8000
# Aggregate benchmark access token, attached by the dev proxy. Server-side only; never prefix with VITE_.
# MIRAGE_EVAL_TOKEN=

# Seeds offered as scenarios and policies offered in the cockpit (comma-separated, server policy keys).
# VITE_MIRAGE_SEEDS=9
# VITE_MIRAGE_POLICIES=rescue_planner,greedy_eig,fixed_pipeline,random
# Request authorised aggregate results (needs MIRAGE_EVAL_TOKEN above). Off by default: the endpoint 404s when disabled.
# VITE_MIRAGE_BENCHMARKS=1
# Request the authorised per-episode correct-vs-justified verdict when an episode ends (provisional route /benchmarks/episodes/{id}).
# VITE_MIRAGE_EVALUATION=1

# Base URL override for the API (default same-origin /api via the proxy).
# VITE_MIRAGE_API_BASE=/api
# Replay payload directory for ?transport=replay
# VITE_MIRAGE_REPLAY_BASE=/replays
