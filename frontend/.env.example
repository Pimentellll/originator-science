# Transport selection: mock (default) | replay | live. Can also be set per-session with ?transport=live
VITE_MIRAGE_TRANSPORT=mock
# Base URL for LiveApiTransport. Empty = same-origin /api (proxied to MIRAGE_API_PROXY in `vite dev`).
VITE_MIRAGE_API_BASE=
# Directory/URL holding replay payloads for ReplayTransport (index.json + <episode>.json).
VITE_MIRAGE_REPLAY_BASE=/replays
